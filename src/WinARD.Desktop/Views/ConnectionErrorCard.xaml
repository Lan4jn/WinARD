<UserControl
    x:Class="WinARD.Desktop.Views.ConnectionErrorCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ContentControl AutomationProperties.AutomationId="ConnectionErrorCard">
    <Border Padding="16"
            BorderThickness="1"
            BorderBrush="{ThemeResource SystemFillColorCriticalBrush}"
            CornerRadius="8"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
        <StackPanel Spacing="8">
            <TextBlock x:Name="TitleText"
                       FontSize="18"
                       FontWeight="SemiBold"
                       AutomationProperties.AutomationId="ConnectionErrorTitle" />
            <TextBlock x:Name="SummaryText"
                       TextWrapping="Wrap"
                       AutomationProperties.AutomationId="ConnectionErrorSummary" />
            <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock Text="关联 ID：" Opacity="0.68" />
                <TextBlock x:Name="CorrelationText"
                           IsTextSelectionEnabled="True"
                           AutomationProperties.AutomationId="ConnectionErrorCorrelationId" />
            </StackPanel>
            <ItemsControl x:Name="ActionPanel"
                          AutomationProperties.AutomationId="ConnectionErrorActions">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="8" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </StackPanel>
    </Border>
    </ContentControl>
</UserControl>
