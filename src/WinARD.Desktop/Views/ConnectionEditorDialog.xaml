<ContentDialog
    x:Class="WinARD.Desktop.Views.ConnectionEditorDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:WinARD.Desktop.Views"
    Title="连接编辑器"
    PrimaryButtonText="保存"
    CloseButtonText="取消"
    DefaultButton="Primary">
    <ScrollViewer MaxHeight="620" MinWidth="520">
        <StackPanel Spacing="12">
            <TextBlock Text="基本信息" Style="{StaticResource SubtitleTextBlockStyle}" />
            <TextBox x:Name="DisplayNameBox" Header="显示名称" AutomationProperties.AutomationId="ConnectionDisplayName" />
            <TextBox x:Name="HostBox" Header="Mac 地址" AutomationProperties.AutomationId="ConnectionHost" />
            <NumberBox x:Name="PortBox" Header="端口" Minimum="1" Maximum="65535" SpinButtonPlacementMode="Compact" AutomationProperties.AutomationId="ConnectionPort" />
            <TextBox x:Name="MacUsernameBox" Header="Mac 用户名" AutomationProperties.AutomationId="ConnectionMacUsername" />
            <PasswordBox x:Name="MacPasswordBox" Header="Mac 密码（仅在提交时读取）" PasswordChanged="OnPasswordChanged" AutomationProperties.AutomationId="ConnectionMacPassword" />

            <ComboBox x:Name="CredentialModeBox" Header="凭据保存方式" SelectionChanged="OnCredentialModeChanged" AutomationProperties.AutomationId="CredentialSaveMode">
                <ComboBoxItem Content="Windows 凭据管理器" Tag="WindowsCredentialManager" />
                <ComboBoxItem Content="WinARD 加密库" Tag="EncryptedVault" />
                <ComboBoxItem Content="每次询问" Tag="AskEveryTime" />
            </ComboBox>
            <TextBlock
                Text="切换为“每次询问”只会停止引用原凭据；旧密码会保留。可在“设置”中全局迁移凭据并逐项确认清理。"
                TextWrapping="Wrap"
                Opacity="0.72" />
            <PasswordBox x:Name="VaultMasterPasswordBox" Header="加密库主密码（仅用于创建或解锁）" AutomationProperties.AutomationId="VaultMasterPassword" />

            <ToggleSwitch x:Name="UseSshSwitch" Header="通过 SSH 隧道连接" Toggled="OnUseSshToggled" AutomationProperties.AutomationId="ConnectionUseSsh" />
            <Expander x:Name="SshSection" Header="SSH 设置">
                <StackPanel Spacing="10" Padding="0,8,0,0">
                    <TextBox x:Name="SshHostBox" Header="SSH 主机" AutomationProperties.AutomationId="ConnectionSshHost" />
                    <NumberBox x:Name="SshPortBox" Header="SSH 端口" Minimum="1" Maximum="65535" SpinButtonPlacementMode="Compact" AutomationProperties.AutomationId="ConnectionSshPort" />
                    <TextBox x:Name="SshUsernameBox" Header="SSH 用户名" AutomationProperties.AutomationId="ConnectionSshUsername" />
                    <TextBox x:Name="SshTargetHostBox" Header="目标 Mac 主机" AutomationProperties.AutomationId="ConnectionSshTargetHost" />
                    <NumberBox x:Name="SshTargetPortBox" Header="目标 Mac 端口" Minimum="1" Maximum="65535" SpinButtonPlacementMode="Compact" AutomationProperties.AutomationId="ConnectionSshTargetPort" />
                    <ComboBox x:Name="SshAuthenticationModeBox" Header="SSH 认证方式" SelectionChanged="OnSshAuthenticationModeChanged" AutomationProperties.AutomationId="ConnectionSshAuthenticationMode">
                        <ComboBoxItem Content="密码" />
                        <ComboBoxItem Content="私钥" />
                    </ComboBox>
                    <TextBox x:Name="PrivateKeyPathBox" Header="私钥路径" AutomationProperties.AutomationId="ConnectionPrivateKeyPath" />
                    <PasswordBox x:Name="SshPasswordBox" Header="SSH 密码或私钥口令（临时）" PasswordChanged="OnPasswordChanged" AutomationProperties.AutomationId="ConnectionSshPassword" />
                </StackPanel>
            </Expander>

            <Border x:Name="HostKeyPromptPanel"
                    Visibility="Collapsed"
                    Padding="12"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    CornerRadius="6"
                    AutomationProperties.AutomationId="EditorHostKeyPrompt">
                <StackPanel Spacing="8">
                    <TextBlock x:Name="HostKeyPromptTitle" FontWeight="SemiBold" />
                    <TextBlock Text="请在继续前核对以下 SSH 主机密钥信息。" TextWrapping="Wrap" />
                    <TextBlock x:Name="HostKeyEndpointText" AutomationProperties.AutomationId="EditorHostKeyEndpoint" />
                    <TextBlock x:Name="HostKeyAlgorithmText" AutomationProperties.AutomationId="EditorHostKeyAlgorithm" />
                    <TextBlock x:Name="HostKeyPreviousFingerprintText" TextWrapping="Wrap" AutomationProperties.AutomationId="EditorHostKeyPreviousFingerprint" />
                    <TextBlock x:Name="HostKeyNewFingerprintText" TextWrapping="Wrap" AutomationProperties.AutomationId="EditorHostKeyNewFingerprint" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="TrustHostKeyButton" Content="信任" Click="OnTrustHostKeyClicked" AutomationProperties.AutomationId="EditorTrustHostKey" />
                        <Button x:Name="ReplaceHostKeyButton" Content="替换" Click="OnReplaceHostKeyClicked" AutomationProperties.AutomationId="EditorReplaceHostKey" />
                        <Button Content="取消" Click="OnCancelHostKeyClicked" AutomationProperties.AutomationId="EditorCancelHostKey" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Button x:Name="TestButton" Content="测试连接" Click="OnTestClicked" HorizontalAlignment="Left" AutomationProperties.AutomationId="TestConnectionButton" />
            <ProgressRing x:Name="BusyIndicator" IsActive="False" Width="24" Height="24" HorizontalAlignment="Left" />
            <TextBlock x:Name="StatusText" TextWrapping="Wrap" AutomationProperties.AutomationId="ConnectionEditorStatus" />
            <local:ConnectionErrorCard x:Name="ErrorCard" />
            <TextBlock Text="阶段 / 用时 / 消息" FontWeight="SemiBold" />
            <ItemsControl x:Name="StageResults">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{Binding Stage}" />
                            <TextBlock Text="{Binding Duration}" />
                            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
