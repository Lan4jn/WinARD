<Window
    x:Class="WinARD.Desktop.Views.RemoteSessionWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewModels="using:WinARD.Desktop.ViewModels"
    xmlns:views="using:WinARD.Desktop.Views"
    Title="WinARD 远程会话">
    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <CommandBar DefaultLabelPosition="Right">
            <CommandBar.Content>
                <StackPanel
                    Margin="8,0,16,0"
                    Orientation="Horizontal"
                    Spacing="8"
                    VerticalAlignment="Center">
                    <TextBlock
                        Text="刷新频率"
                        VerticalAlignment="Center" />
                    <ComboBox
                        x:Name="FrameRateComboBox"
                        MinWidth="128"
                        AutomationProperties.AutomationId="RemoteFrameRateComboBox"
                        AutomationProperties.Name="刷新频率选择"
                        DropDownOpened="OnFrameRateDropDownOpened"
                        SelectionChanged="OnFrameRateSelectionChanged">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="viewModels:FrameRefreshOption">
                                <StackPanel>
                                    <TextBlock Text="{x:Bind DisplayName}" />
                                    <TextBlock
                                        FontSize="11"
                                        Opacity="0.7"
                                        Text="{x:Bind ConstraintText}" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button
                        x:Name="QualitySummaryButton"
                        AutomationProperties.AutomationId="RemoteQualitySummaryButton"
                        AutomationProperties.Name="画质设置"
                        Click="OnQualitySummaryClicked"
                        Content="画质  自动 · — · — · — · —" />
                </StackPanel>
            </CommandBar.Content>
            <AppBarButton
                x:Name="FitButton"
                AutomationProperties.AutomationId="RemoteFitButton"
                Click="OnFitClicked"
                Label="适应窗口" />
            <AppBarButton
                x:Name="ActualSizeButton"
                AutomationProperties.AutomationId="RemoteActualSizeButton"
                Click="OnActualSizeClicked"
                Label="100%" />
            <AppBarSeparator />
            <AppBarButton
                AutomationProperties.AutomationId="RemoteCtrlAltDeleteButton"
                Click="OnSecureAttentionClicked"
                Label="Ctrl+Alt+Delete" />
            <AppBarToggleButton
                x:Name="ClipboardButton"
                AutomationProperties.AutomationId="RemoteClipboardButton"
                Click="OnClipboardClicked"
                IsChecked="True"
                Label="剪贴板" />
            <AppBarButton
                x:Name="ExportDiagnosticsButton"
                AutomationProperties.AutomationId="RemoteExportDiagnosticsButton"
                Click="OnExportDiagnosticsClicked"
                Label="导出诊断" />
            <AppBarButton
                AutomationProperties.AutomationId="RemoteFullscreenButton"
                Click="OnFullscreenClicked"
                Label="全屏" />
            <AppBarButton
                AutomationProperties.AutomationId="RemoteDisconnectButton"
                Click="OnDisconnectClicked"
                Label="断开" />
        </CommandBar>

        <Grid x:Name="ViewportHost" Grid.Row="1" Background="Black">
            <ScrollViewer
                x:Name="FrameScrollViewer"
                AutomationProperties.AutomationId="RemoteFrameScrollViewer"
                HorizontalScrollBarVisibility="Disabled"
                HorizontalScrollMode="Disabled"
                VerticalScrollBarVisibility="Disabled"
                VerticalScrollMode="Disabled"
                ZoomMode="Disabled">
                <Grid
                    x:Name="FrameSurface"
                    Background="Transparent"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top">
                    <Viewbox
                        x:Name="FrameViewbox"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Stretch="Uniform">
                        <Button
                            AutomationProperties.AutomationId="RemoteSwapChainPanel"
                            AutomationProperties.Name="远程画面"
                            Background="Transparent"
                            BorderThickness="0"
                            HorizontalContentAlignment="Stretch"
                            IsHitTestVisible="False"
                            IsTabStop="False"
                            Padding="0"
                            VerticalContentAlignment="Stretch">
                            <SwapChainPanel
                                x:Name="FramePanel"
                                Width="1"
                                Height="1" />
                        </Button>
                    </Viewbox>
                    <views:RemoteInputSurface
                        x:Name="InputSurface"
                        AutomationProperties.AutomationId="RemoteInputSurface"
                        Padding="0"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch"
                        Background="Transparent"
                        BorderThickness="0" />
                    <Canvas IsHitTestVisible="False">
                        <Image
                            x:Name="RemoteCursorOverlay"
                            AutomationProperties.AutomationId="RemoteCursorOverlay"
                            IsHitTestVisible="False"
                            Stretch="Fill"
                            Visibility="Collapsed" />
                    </Canvas>
                </Grid>
            </ScrollViewer>
            <views:ConnectionErrorCard
                x:Name="SessionErrorCard"
                Margin="24"
                HorizontalAlignment="Center"
                VerticalAlignment="Top" />
        </Grid>

        <Canvas
            x:Name="QualityOverlayLayer"
            Grid.RowSpan="3"
            Canvas.ZIndex="2"
            IsHitTestVisible="False">
            <Border
                x:Name="QualityOverlay"
                AutomationProperties.AutomationId="RemoteQualityOverlay"
                AutomationProperties.Name="画质悬浮面板"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                Canvas.ZIndex="2"
                IsHitTestVisible="True"
                KeyDown="OnQualityOverlayKeyDown"
                Padding="12"
                PointerPressed="OnQualityOverlayPointerPressed"
                Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition x:Name="QualityOverlayHeaderRow" Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <TextBlock x:Name="QualityOverlayTitle" FontSize="18" Text="画质" />
                        <Button x:Name="QualityCloseButton" HorizontalAlignment="Right" AutomationProperties.AutomationId="RemoteQualityCloseButton" AutomationProperties.Name="关闭画质面板" Click="OnQualityCloseClicked" Content="关闭" />
                    </Grid>
                    <ScrollViewer
                    x:Name="QualityOverlayScrollViewer"
                    Grid.Row="1"
                    HorizontalScrollBarVisibility="Auto"
                    HorizontalScrollMode="Enabled"
                    VerticalScrollBarVisibility="Auto"
                    VerticalScrollMode="Enabled">
                    <StackPanel MinWidth="120" Spacing="8">
                        <TextBlock x:Name="QualityStatusText" AutomationProperties.AutomationId="RemoteQualityStatus" AutomationProperties.Name="画质状态" AutomationProperties.LiveSetting="Polite" Text="状态未知" />
                        <TextBlock x:Name="QualityDesiredText" AutomationProperties.AutomationId="RemoteQualityDesiredText" AutomationProperties.Name="期望画质" Text="期望：—" />
                        <TextBlock x:Name="QualityAppliedText" AutomationProperties.AutomationId="RemoteQualityAppliedText" AutomationProperties.Name="实际画质" AutomationProperties.LiveSetting="Polite" Text="实际：—" />
                        <TextBlock x:Name="QualityScaleStateText" AutomationProperties.AutomationId="RemoteQualityScaleStateText" AutomationProperties.Name="缩放设置与实际状态" Text="设置：自动 · 本连接解析：— · 本连接实际：—" TextWrapping="Wrap" />
                        <TextBlock Text="预设" />
                        <ComboBox x:Name="QualityPresetComboBox" AutomationProperties.AutomationId="RemoteQualityPresetComboBox" AutomationProperties.Name="画质预设" DisplayMemberPath="DisplayName" DropDownClosed="OnQualityDropDownClosed" DropDownOpened="OnQualityDropDownOpened" SelectionChanged="OnQualityPresetSelectionChanged" />
                        <TextBlock Text="带宽目标" />
                        <ComboBox x:Name="QualityBandwidthComboBox" AutomationProperties.AutomationId="RemoteQualityBandwidthComboBox" AutomationProperties.Name="带宽目标" DisplayMemberPath="DisplayName" DropDownClosed="OnQualityDropDownClosed" DropDownOpened="OnQualityDropDownOpened" SelectionChanged="OnQualityDetailSelectionChanged" />
                        <NumberBox x:Name="QualityCustomBandwidthBox" AutomationProperties.AutomationId="RemoteQualityCustomBandwidthBox" AutomationProperties.Name="自定义带宽" Header="自定义带宽 (MiB/s)" Minimum="0.1" Maximum="1048576" SmallChange="0.1" SpinButtonPlacementMode="Compact" Value="3" ValueChanged="OnQualityCustomBandwidthChanged" />
                        <TextBlock Text="色彩" />
                        <ComboBox x:Name="QualityColorComboBox" AutomationProperties.AutomationId="RemoteQualityColorComboBox" AutomationProperties.Name="画质色彩" DisplayMemberPath="DisplayName" DropDownClosed="OnQualityDropDownClosed" DropDownOpened="OnQualityColorDropDownOpened" SelectionChanged="OnQualityDetailSelectionChanged" />
                        <TextBlock Text="缩放" />
                        <ComboBox x:Name="QualityScaleComboBox" AutomationProperties.AutomationId="RemoteQualityScaleComboBox" AutomationProperties.Name="画质缩放" DisplayMemberPath="DisplayName" DropDownClosed="OnQualityDropDownClosed" DropDownOpened="OnQualityScaleDropDownOpened" SelectionChanged="OnQualityDetailSelectionChanged" />
                        <TextBlock Text="刷新率" />
                        <ComboBox x:Name="QualityRefreshComboBox" AutomationProperties.AutomationId="RemoteQualityRefreshComboBox" AutomationProperties.Name="画质刷新率" DisplayMemberPath="DisplayName" DropDownClosed="OnQualityDropDownClosed" DropDownOpened="OnQualityRefreshDropDownOpened" SelectionChanged="OnQualityDetailSelectionChanged" />
                        <ToggleSwitch x:Name="QualityGrayscaleToggle" AutomationProperties.AutomationId="RemoteQualityAllowGrayscaleToggle" AutomationProperties.Name="允许自动使用灰度" Header="允许自动使用灰度" Toggled="OnQualityDetailToggled" />
                        <TextBlock Text="锁定项" />
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <CheckBox x:Name="QualityBandwidthLock" Content="带宽" Click="OnQualityLockClicked" />
                            <CheckBox x:Name="QualityColorLock" Content="色彩" Click="OnQualityLockClicked" />
                            <CheckBox x:Name="QualityScaleLock" Content="缩放" Click="OnQualityLockClicked" />
                            <CheckBox x:Name="QualityRefreshLock" Content="刷新" Click="OnQualityLockClicked" />
                        </StackPanel>
                        <TextBlock Text="当前编码" />
                        <TextBlock x:Name="QualityEncodingText" AutomationProperties.AutomationId="RemoteQualityEncodingText" AutomationProperties.Name="当前编码" Text="Unknown" />
                        <StackPanel x:Name="QualityReconnectActions" Orientation="Horizontal" Spacing="8" Visibility="Collapsed">
                            <Button x:Name="QualityReconnectNowButton" AutomationProperties.AutomationId="RemoteQualityReconnectNowButton" AutomationProperties.Name="立即重新连接" Click="OnQualityReconnectNowClicked" Content="立即重新连接" />
                            <Button x:Name="QualityLaterButton" AutomationProperties.AutomationId="RemoteQualityLaterButton" AutomationProperties.Name="稍后重新连接" Click="OnQualityLaterClicked" Content="稍后" />
                        </StackPanel>
                    </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Canvas>

        <Grid Grid.Row="2" Padding="12,8" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock
                    x:Name="StatusText"
                    AutomationProperties.AutomationId="RemoteSessionStatus"
                    VerticalAlignment="Center" />
                <TextBlock
                    x:Name="FrameRateSaveStatusText"
                    AutomationProperties.AutomationId="RemoteFrameRateSaveStatus"
                    AutomationProperties.LiveSetting="Polite"
                    Foreground="DarkGoldenrod"
                    Visibility="Collapsed" />
                <StackPanel x:Name="AutomaticReconnectPanel" Orientation="Horizontal" Spacing="8" Visibility="Collapsed">
                    <TextBlock x:Name="AutomaticReconnectStatusText" AutomationProperties.AutomationId="RemoteAutomaticReconnectStatus" AutomationProperties.LiveSetting="Polite" VerticalAlignment="Center" />
                    <Button AutomationProperties.AutomationId="RemoteCancelAutomaticReconnect" AutomationProperties.Name="取消自动重连" Click="OnCancelAutomaticReconnectClicked" Content="取消" />
                </StackPanel>
            </StackPanel>
            <StackPanel
                Grid.Column="1"
                Margin="8,0"
                VerticalAlignment="Center">
                <TextBlock
                    x:Name="PerformanceText"
                    AutomationProperties.AutomationId="RemoteSessionPerformance"
                    Opacity="0.8"
                    Text="自动 — · 实际 — · — · — · —"
                    VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel
                x:Name="QualityPanel"
                Grid.Column="2"
                AutomationProperties.AutomationId="RemoteConnectionQualityIndicator"
                Orientation="Horizontal"
                Spacing="8"
                VerticalAlignment="Center">
                <Ellipse
                    x:Name="QualityIndicator"
                    Width="10"
                    Height="10"
                    Fill="Gray" />
                <TextBlock
                    x:Name="QualityText"
                    Opacity="0.8"
                    Text="等待测量"
                    VerticalAlignment="Center" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
