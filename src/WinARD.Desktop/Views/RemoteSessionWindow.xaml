<Window
    x:Class="WinARD.Desktop.Views.RemoteSessionWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:viewModels="using:WinARD.Desktop.ViewModels"
    xmlns:views="using:WinARD.Desktop.Views"
    Title="WinARD 远程会话">
    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <CommandBar DefaultLabelPosition="Right">
            <CommandBar.Content>
                <StackPanel
                    Margin="8,0,16,0"
                    Orientation="Horizontal"
                    Spacing="8"
                    VerticalAlignment="Center">
                    <TextBlock
                        Text="刷新频率"
                        VerticalAlignment="Center" />
                    <ComboBox
                        x:Name="FrameRateComboBox"
                        MinWidth="128"
                        AutomationProperties.AutomationId="RemoteFrameRateComboBox"
                        AutomationProperties.Name="刷新频率选择"
                        DropDownOpened="OnFrameRateDropDownOpened"
                        SelectionChanged="OnFrameRateSelectionChanged">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="viewModels:FrameRefreshOption">
                                <StackPanel>
                                    <TextBlock Text="{x:Bind DisplayName}" />
                                    <TextBlock
                                        FontSize="11"
                                        Opacity="0.7"
                                        Text="{x:Bind ConstraintText}" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button
                        x:Name="QualitySummaryButton"
                        AutomationProperties.AutomationId="RemoteQualitySummaryButton"
                        AutomationProperties.Name="画质设置"
                        Content="画质  自动 · — · — · — · —">
                        <Button.Flyout>
                            <Flyout Placement="Bottom">
                                <ScrollViewer MaxHeight="620">
                                    <StackPanel Width="360" Spacing="8">
                                        <TextBlock FontSize="18" Text="画质" />
                                        <TextBlock
                                            x:Name="QualityStatusText"
                                            AutomationProperties.AutomationId="RemoteQualityStatus"
                                            AutomationProperties.Name="画质状态：状态未知"
                                            AutomationProperties.LiveSetting="Polite"
                                            Text="状态未知" />
                                        <TextBlock Text="预设" />
                                        <ComboBox
                                            x:Name="QualityPresetComboBox"
                                            AutomationProperties.AutomationId="RemoteQualityPresetComboBox"
                                            AutomationProperties.Name="画质预设"
                                            DisplayMemberPath="DisplayName"
                                            SelectionChanged="OnQualityPresetSelectionChanged" />
                                        <TextBlock Text="带宽目标" />
                                        <ComboBox
                                            x:Name="QualityBandwidthComboBox"
                                            AutomationProperties.AutomationId="RemoteQualityBandwidthComboBox"
                                            AutomationProperties.Name="画质带宽目标"
                                            DisplayMemberPath="DisplayName"
                                            SelectionChanged="OnQualityDetailSelectionChanged" />
                                        <NumberBox
                                            x:Name="QualityCustomBandwidthBox"
                                            AutomationProperties.AutomationId="RemoteQualityCustomBandwidthBox"
                                            AutomationProperties.Name="自定义带宽，MiB 每秒"
                                            Header="自定义带宽 (MiB/s)"
                                            Minimum="0.1"
                                            Maximum="1048576"
                                            SmallChange="0.1"
                                            SpinButtonPlacementMode="Compact"
                                            Value="3"
                                            ValueChanged="OnQualityCustomBandwidthChanged" />
                                        <TextBlock Text="色彩" />
                                        <ComboBox
                                            x:Name="QualityColorComboBox"
                                            AutomationProperties.AutomationId="RemoteQualityColorComboBox"
                                            AutomationProperties.Name="画质色彩"
                                            DisplayMemberPath="DisplayName"
                                            SelectionChanged="OnQualityDetailSelectionChanged" />
                                        <TextBlock Text="缩放" />
                                        <ComboBox
                                            x:Name="QualityScaleComboBox"
                                            AutomationProperties.AutomationId="RemoteQualityScaleComboBox"
                                            AutomationProperties.Name="画质缩放"
                                            DisplayMemberPath="DisplayName"
                                            SelectionChanged="OnQualityDetailSelectionChanged" />
                                        <TextBlock Text="刷新率" />
                                        <ComboBox
                                            x:Name="QualityRefreshComboBox"
                                            AutomationProperties.AutomationId="RemoteQualityRefreshComboBox"
                                            AutomationProperties.Name="画质刷新率"
                                            DisplayMemberPath="DisplayName"
                                            DropDownOpened="OnQualityRefreshDropDownOpened"
                                            SelectionChanged="OnQualityDetailSelectionChanged" />
                                        <ToggleSwitch
                                            x:Name="QualityGrayscaleToggle"
                                            AutomationProperties.AutomationId="RemoteQualityAllowGrayscaleToggle"
                                            AutomationProperties.Name="允许自动使用灰度"
                                            Header="允许自动使用灰度"
                                            Toggled="OnQualityDetailToggled" />
                                        <TextBlock Text="锁定项" />
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <CheckBox x:Name="QualityBandwidthLock" AutomationProperties.AutomationId="RemoteQualityBandwidthLock" AutomationProperties.Name="锁定带宽目标" Content="带宽" Click="OnQualityLockClicked" />
                                            <CheckBox x:Name="QualityColorLock" AutomationProperties.AutomationId="RemoteQualityColorLock" AutomationProperties.Name="锁定色彩" Content="色彩" Click="OnQualityLockClicked" />
                                            <CheckBox x:Name="QualityScaleLock" AutomationProperties.AutomationId="RemoteQualityScaleLock" AutomationProperties.Name="锁定缩放" Content="缩放" Click="OnQualityLockClicked" />
                                            <CheckBox x:Name="QualityRefreshLock" AutomationProperties.AutomationId="RemoteQualityRefreshLock" AutomationProperties.Name="锁定刷新率" Content="刷新" Click="OnQualityLockClicked" />
                                        </StackPanel>
                                        <TextBlock Text="当前编码" />
                                        <TextBlock
                                            x:Name="QualityEncodingText"
                                            AutomationProperties.AutomationId="RemoteQualityEncodingText"
                                            AutomationProperties.Name="当前编码：Unknown"
                                            Text="Unknown" />
                                    </StackPanel>
                                </ScrollViewer>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </StackPanel>
            </CommandBar.Content>
            <AppBarButton
                x:Name="FitButton"
                AutomationProperties.AutomationId="RemoteFitButton"
                Click="OnFitClicked"
                Label="适应窗口" />
            <AppBarButton
                x:Name="ActualSizeButton"
                AutomationProperties.AutomationId="RemoteActualSizeButton"
                Click="OnActualSizeClicked"
                Label="100%" />
            <AppBarSeparator />
            <AppBarButton
                AutomationProperties.AutomationId="RemoteCtrlAltDeleteButton"
                Click="OnSecureAttentionClicked"
                Label="Ctrl+Alt+Delete" />
            <AppBarToggleButton
                x:Name="ClipboardButton"
                AutomationProperties.AutomationId="RemoteClipboardButton"
                Click="OnClipboardClicked"
                IsChecked="True"
                Label="剪贴板" />
            <AppBarButton
                x:Name="ExportDiagnosticsButton"
                AutomationProperties.AutomationId="RemoteExportDiagnosticsButton"
                Click="OnExportDiagnosticsClicked"
                Label="导出诊断" />
            <AppBarButton
                AutomationProperties.AutomationId="RemoteFullscreenButton"
                Click="OnFullscreenClicked"
                Label="全屏" />
            <AppBarButton
                AutomationProperties.AutomationId="RemoteDisconnectButton"
                Click="OnDisconnectClicked"
                Label="断开" />
        </CommandBar>

        <Grid x:Name="ViewportHost" Grid.Row="1" Background="Black">
            <ScrollViewer
                x:Name="FrameScrollViewer"
                AutomationProperties.AutomationId="RemoteFrameScrollViewer"
                HorizontalScrollBarVisibility="Disabled"
                HorizontalScrollMode="Disabled"
                VerticalScrollBarVisibility="Disabled"
                VerticalScrollMode="Disabled"
                ZoomMode="Disabled">
                <Grid
                    x:Name="FrameSurface"
                    Background="Transparent"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top">
                    <Viewbox
                        x:Name="FrameViewbox"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Stretch="Uniform">
                        <Button
                            AutomationProperties.AutomationId="RemoteSwapChainPanel"
                            AutomationProperties.Name="远程画面"
                            Background="Transparent"
                            BorderThickness="0"
                            HorizontalContentAlignment="Stretch"
                            IsHitTestVisible="False"
                            IsTabStop="False"
                            Padding="0"
                            VerticalContentAlignment="Stretch">
                            <SwapChainPanel
                                x:Name="FramePanel"
                                Width="1"
                                Height="1" />
                        </Button>
                    </Viewbox>
                    <views:RemoteInputSurface
                        x:Name="InputSurface"
                        AutomationProperties.AutomationId="RemoteInputSurface"
                        Padding="0"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch"
                        Background="Transparent"
                        BorderThickness="0" />
                    <Canvas IsHitTestVisible="False">
                        <Image
                            x:Name="RemoteCursorOverlay"
                            AutomationProperties.AutomationId="RemoteCursorOverlay"
                            IsHitTestVisible="False"
                            Stretch="Fill"
                            Visibility="Collapsed" />
                    </Canvas>
                </Grid>
            </ScrollViewer>
            <views:ConnectionErrorCard
                x:Name="SessionErrorCard"
                Margin="24"
                HorizontalAlignment="Center"
                VerticalAlignment="Top" />
        </Grid>

        <Grid Grid.Row="2" Padding="12,8" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock
                    x:Name="StatusText"
                    AutomationProperties.AutomationId="RemoteSessionStatus"
                    VerticalAlignment="Center" />
                <TextBlock
                    x:Name="FrameRateSaveStatusText"
                    AutomationProperties.AutomationId="RemoteFrameRateSaveStatus"
                    AutomationProperties.LiveSetting="Polite"
                    Foreground="DarkGoldenrod"
                    Visibility="Collapsed" />
            </StackPanel>
            <StackPanel
                Grid.Column="1"
                Margin="8,0"
                VerticalAlignment="Center">
                <TextBlock
                    x:Name="PerformanceText"
                    AutomationProperties.AutomationId="RemoteSessionPerformance"
                    Opacity="0.8"
                    Text="自动 — · 实际 — · — · — · —"
                    VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel
                x:Name="QualityPanel"
                Grid.Column="2"
                AutomationProperties.AutomationId="RemoteConnectionQualityIndicator"
                Orientation="Horizontal"
                Spacing="8"
                VerticalAlignment="Center">
                <Ellipse
                    x:Name="QualityIndicator"
                    Width="10"
                    Height="10"
                    Fill="Gray" />
                <TextBlock
                    x:Name="QualityText"
                    Opacity="0.8"
                    Text="等待测量"
                    VerticalAlignment="Center" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
